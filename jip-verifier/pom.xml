<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>xyz.larsw</groupId>
    <artifactId>jena-intrinsic-provenance-parent</artifactId>
    <version>0.14.0</version>
  </parent>

  <artifactId>jip-verifier</artifactId>
  <packaging>jar</packaging>

  <name>Jena intrinsic provenance: verifier library</name>
  <description>
    Offline verification of jip result attestations: RDFC-1.0 canonicalization, the rs: result
    encoding, eddsa-rdfc-2022 Data Integrity proofs, Ed25519 did:key and RFC 3161 timestamp
    tokens. Needs jena-arq, titanium-rdfc and BouncyCastle; no TDB2 or Fuseki.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
    </dependency>
    <!-- RDFC-1.0. A plain dependency here; jena-intrinsic-provenance shades and relocates it
         because Fuseki bundles other versions of com.apicatalog.rdf.* -->
    <dependency>
      <groupId>com.apicatalog</groupId>
      <artifactId>titanium-rdfc</artifactId>
    </dependency>
    <!-- RFC 3161 time-stamp protocol: requests, replies and token (CMS) verification -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The test TSA (TestTsa) is reused by the Fuseki module's tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

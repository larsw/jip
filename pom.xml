<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example.jena</groupId>
  <artifactId>jena-intrinsic-provenance</artifactId>
  <version>0.9.0</version>
  <packaging>jar</packaging>

  <name>Jena intrinsic provenance (PoC)</name>
  <description>
    Persistent TDB2 data version counter and signed PROV-O result certificates
    (RDFC-1.0 + eddsa-rdfc-2022) for Apache Jena / Fuseki.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <ver.jena>6.2.0</ver.jena>
    <ver.titanium-rdfc>3.0.0</ver.titanium-rdfc>
    <ver.junit>6.1.2</ver.junit>
    <ver.log4j2>2.26.1</ver.log4j2>
    <shade.prefix>org.example.jena.provenance.shaded</shade.prefix>
  </properties>

  <dependencies>
    <!-- Jena and Fuseki are supplied at runtime by jena-fuseki-server.jar -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
      <version>${ver.jena}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-tdb2</artifactId>
      <version>${ver.jena}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-fuseki-main</artifactId>
      <version>${ver.jena}</version>
      <scope>provided</scope>
    </dependency>

    <!-- RDFC-1.0; shaded and relocated into the module jar -->
    <dependency>
      <groupId>com.apicatalog</groupId>
      <artifactId>titanium-rdfc</artifactId>
      <version>${ver.titanium-rdfc}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${ver.junit}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${ver.log4j2}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.apicatalog:titanium-rdfc</include>
                  <include>com.apicatalog:titanium-rdf-api</include>
                  <include>com.apicatalog:titanium-rdf-n-quads</include>
                </includes>
              </artifactSet>
              <relocations>
                <!-- Fuseki bundles other versions of com.apicatalog.rdf.* -->
                <relocation>
                  <pattern>com.apicatalog</pattern>
                  <shadedPattern>${shade.prefix}.com.apicatalog</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>com.apicatalog:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

# The jip: vocabulary of jena-intrinsic-provenance.
#
# Terms for persistent TDB2 data versions and for signed PROV-O certificates of SPARQL
# results. VocabularyTest checks that this file defines every jip: term the code uses,
# and no others.

PREFIX jip:     <https://larsw.xyz/jip/>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX vann:    <http://purl.org/vocab/vann/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX sd:      <http://www.w3.org/ns/sparql-service-description#>
PREFIX ja:      <http://jena.hpl.hp.com/2005/11/Assembler#>
PREFIX tdb2:    <http://jena.apache.org/2016/tdb#>

<https://larsw.xyz/jip/>
    a owl:Ontology ;
    dcterms:title "Jena intrinsic provenance (jip) vocabulary"@en ;
    dcterms:description """Terms used by jena-intrinsic-provenance, a module for Apache Jena
and Fuseki. It adds a persistent data version to TDB2 databases and certifies the solutions
of a SPARQL pattern wrapped in SERVICE <urn:x-provenance:certify>. A certificate is a PROV-O
graph that names the database state the solutions were read from, records an RDFC-1.0 based
SHA-256 digest of the solutions, and carries a W3C Data Integrity proof (eddsa-rdfc-2022)
from the https://w3id.org/security# vocabulary."""@en ;
    dcterms:creator "Lars Wilhelmsen" ;
    dcterms:created "2026-11-15"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    vann:preferredNamespacePrefix "jip" ;
    vann:preferredNamespaceUri "https://larsw.xyz/jip/" ;
    rdfs:seeAlso <https://www.w3.org/TR/prov-o/> ,
                 <https://www.w3.org/TR/rdf-canon/> ,
                 <https://www.w3.org/TR/vc-di-eddsa/> .

## ---- Certificates

jip:ResultCertificate
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "result certificate"@en ;
    rdfs:comment """A signed statement that a solution sequence was obtained from a given
dataset state. Its IRI is urn:uuid:<uuid>, it is stored as a named graph of the same name,
and it carries one sec:proof with the eddsa-rdfc-2022 cryptosuite."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:SolutionSequence
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "solution sequence"@en ;
    rdfs:comment """The solutions of the pattern inside one call of the certify SERVICE. Only
the digest of the solutions is recorded, never the solutions themselves."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:QueryExecution
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "query execution"@en ;
    rdfs:comment """The evaluation of a certified pattern. Its prov:startedAtTime and
prov:endedAtTime come from the server clock."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:DatasetState
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "dataset state"@en ;
    rdfs:comment """One committed state of a versioned TDB2 database, named
urn:uuid:<database id>#v<version>. It is a prov:specializationOf the logical dataset
(jip:datasetIRI), or of urn:uuid:<database id> if none is configured."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:certifies
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain jip:ResultCertificate ;
    rdfs:range jip:SolutionSequence ;
    rdfs:label "certifies"@en ;
    rdfs:comment "Links a certificate to the solution sequence it certifies."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:variable
    a owl:DatatypeProperty ;
    rdfs:domain jip:SolutionSequence ;
    rdfs:range xsd:string ;
    rdfs:label "variable"@en ;
    rdfs:comment """The name, without '?', of a certified variable. A solution sequence has one
value per variable visible in the certified pattern, excluding the certificate variable."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:ordered
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:SolutionSequence ;
    rdfs:range xsd:boolean ;
    rdfs:label "ordered"@en ;
    rdfs:comment """True if the certified pattern has ORDER BY (or a top-N operation) at the top.
Row order is then part of the digest; otherwise the digest doesn't depend on row order."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:solutionCount
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:SolutionSequence ;
    rdfs:range xsd:integer ;
    rdfs:label "solution count"@en ;
    rdfs:comment "The number of certified solutions, duplicates included. 0 for an empty result."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:canonicalization
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain jip:SolutionSequence ;
    rdfs:label "canonicalization"@en ;
    rdfs:comment """The canonicalization algorithm applied to the result-set encoding of the
solutions before hashing, identified by its specification: <https://www.w3.org/TR/rdf-canon/>
for RDFC-1.0."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:digestAlgorithm
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:SolutionSequence ;
    rdfs:range xsd:string ;
    rdfs:label "digest algorithm"@en ;
    rdfs:comment "The hash function used for jip:digest, for example \"SHA-256\"."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:digest
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:SolutionSequence ;
    rdfs:range xsd:string ;
    rdfs:label "digest"@en ;
    rdfs:comment """Lowercase hexadecimal hash of the canonical N-Quads of the solutions, encoded
with the result-set vocabulary <http://www.w3.org/2001/sw/DataAccess/tests/result-set#>."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:servicePattern
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:QueryExecution ;
    rdfs:range xsd:string ;
    rdfs:label "service pattern"@en ;
    rdfs:comment "The certified pattern, the body of the certify SERVICE, as SPARQL text."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:queryText
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:QueryExecution ;
    rdfs:range xsd:string ;
    rdfs:label "query text"@en ;
    rdfs:comment "The whole query that contained the certify SERVICE, as SPARQL text, when available."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:dataVersion
    a owl:DatatypeProperty , owl:FunctionalProperty , sd:Function ;
    rdfs:domain jip:DatasetState ;
    rdfs:range xsd:integer ;
    rdfs:label "data version"@en ;
    rdfs:comment """As a property: the persistent data version of a dataset state. It starts at 0
and goes up by one on every committed write transaction.

As a SPARQL function, jip:dataVersion(): the persistent data version of the snapshot the query
reads, or the last committed version outside a transaction. It is an error on a dataset that is
not a jip:VersionedDatasetTDB2."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

## ---- RFC 3161 timestamps

jip:RFC3161Timestamp
    a owl:Class ;
    rdfs:label "RFC 3161 timestamp"@en ;
    rdfs:comment """A time-stamp token from a time-stamping authority (TSA, RFC 3161) over a
certificate's signature. The token's message imprint is the SHA-256 hash of the raw signature
bytes decoded from the proof's sec:proofValue; because the signature covers the certificate,
the token proves the certificate existed at the TSA's time. Timestamps are added after signing
and are not part of the signed document: a verifier removes the jip:timestamp links and the
timestamp nodes' triples before checking the Data Integrity proof."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestamp
    a owl:ObjectProperty ;
    rdfs:domain jip:ResultCertificate ;
    rdfs:range jip:RFC3161Timestamp ;
    rdfs:label "timestamp"@en ;
    rdfs:comment "Links a certificate to an RFC 3161 timestamp over its signature."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampToken
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:RFC3161Timestamp ;
    rdfs:range xsd:base64Binary ;
    rdfs:label "timestamp token"@en ;
    rdfs:comment """The DER-encoded TimeStampToken (a CMS SignedData with a TSTInfo), base64
encoded. It includes the TSA's certificate. This is the evidence; the other properties of a
jip:RFC3161Timestamp are informational."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampAuthority
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain jip:RFC3161Timestamp ;
    rdfs:label "timestamp authority"@en ;
    rdfs:comment "Informational: the URL of the TSA endpoint that issued the token."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampTime
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain jip:RFC3161Timestamp ;
    rdfs:range xsd:dateTime ;
    rdfs:label "timestamp time"@en ;
    rdfs:comment "Informational: the genTime of the token, copied out of it for queries."@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:pendingTimestamps
    a rdfs:Resource ;
    rdfs:label "pending timestamps"@en ;
    rdfs:comment """Name of a graph in the certificate store that lists the certificates whose RFC
3161 timestamp is still being fetched (asynchronous timestamps), with
jip:timestampPendingSince. A pending certificate is already stored and signed; the
certificate endpoint answers 202 Accepted with Retry-After for it until the timestamp is added
or, with the optional policy, until it is released without one."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampPendingSince
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "timestamp pending since"@en ;
    rdfs:comment """In the jip:pendingTimestamps graph: when a certificate was stored and started
waiting for its RFC 3161 timestamp. The triple is removed in the same transaction that adds the
timestamp."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

## ---- SPARQL functions

jip:tdbDataVersion
    a sd:Function ;
    rdfs:label "TDB2 data version"@en ;
    rdfs:comment """SPARQL function jip:tdbDataVersion(): TDB2's own data version counter. It is
held in memory only and starts again at 0 when the database is opened, so it is not unique
over time. Provided for comparison with jip:dataVersion()."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

## ---- Configuration (assembler)

jip:VersionedDatasetTDB2
    a owl:Class ;
    rdfs:subClassOf ja:RDFDataset ;
    rdfs:label "versioned TDB2 dataset"@en ;
    rdfs:comment """Assembler type for a TDB2 dataset with a persistent data version. Use it in
place of tdb2:DatasetTDB2; it takes tdb2:location (required), tdb2:unionDefaultGraph and
jip:datasetIRI (optional). Before the database is opened, the assembler replays committed data
version records from the TDB2 journal."""@en ;
    rdfs:seeAlso tdb2:DatasetTDB2 ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:datasetIRI
    a rdf:Property ;
    rdfs:domain jip:VersionedDatasetTDB2 ;
    rdfs:label "dataset IRI"@en ;
    rdfs:comment """The IRI of the logical dataset. Every jip:DatasetState of the database is a
prov:specializationOf this IRI. Given as an IRI; a string literal holding the IRI is also
accepted."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

## ---- Configuration (context symbols, used as ja:cxtName in a ja:context)

jip:certificateStore
    a rdfs:Resource ;
    rdfs:label "certificate store"@en ;
    rdfs:comment """Context symbol, normally set in the Fuseki server's ja:context: the TDB2
location where certificates are stored, one named graph per certificate. It must be a
database other than the versioned dataset."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:maxSolutions
    a rdfs:Resource ;
    rdfs:label "maximum solutions"@en ;
    rdfs:comment """Context symbol, set in the Fuseki server's ja:context: the largest number of
solutions one call of the certify SERVICE accepts (default 10000). A larger result fails the
query; it is never truncated."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampAuthorities
    a rdfs:Resource ;
    rdfs:label "timestamp authorities"@en ;
    rdfs:comment """Context symbol, set in the Fuseki server's ja:context: the URLs of RFC 3161
time-stamping authorities, in priority order, separated by whitespace or commas. When set, every
certificate gets a timestamp from the first authority that answers; an authority that fails is
tried last for the next 60 seconds. The environment variable PROVENANCE_TSA_URLS overrides it
(an empty value turns timestamps off)."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampPolicy
    a rdfs:Resource ;
    rdfs:label "timestamp policy"@en ;
    rdfs:comment """Context symbol, set in the Fuseki server's ja:context: "optional" (default)
issues a certificate without a timestamp when no authority answers (synchronous mode) or after
jip:timestampMaxWait (asynchronous mode); "required" fails the certification (synchronous) or
keeps the certificate pending and retrying (asynchronous). The environment variable
PROVENANCE_TSA_POLICY overrides it."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampTimeout
    a rdfs:Resource ;
    rdfs:label "timestamp timeout"@en ;
    rdfs:comment """Context symbol, set in the Fuseki server's ja:context: the time allowed for
each authority, in milliseconds (default 5000). The environment variable PROVENANCE_TSA_TIMEOUT
overrides it."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampMode
    a rdfs:Resource ;
    rdfs:label "timestamp mode"@en ;
    rdfs:comment """Context symbol, set in the Fuseki server's ja:context: "async" (default) stores
each certificate at once and fetches its RFC 3161 timestamp in the background, so queries don't
wait for a TSA; "sync" fetches the timestamp before the query returns. The environment variable
PROVENANCE_TSA_MODE overrides it."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:timestampMaxWait
    a rdfs:Resource ;
    rdfs:label "timestamp maximum wait"@en ;
    rdfs:comment """Context symbol, set in the Fuseki server's ja:context: with asynchronous
timestamps and the optional policy, how long to keep retrying, in milliseconds (default
600000), before a certificate is released without a timestamp. With the required policy the
certificate stays pending and retries continue. The environment variable
PROVENANCE_TSA_MAX_WAIT overrides it."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .

jip:dataVersionComponent
    a rdfs:Resource ;
    rdfs:label "data version component"@en ;
    rdfs:comment """Internal context symbol under which the module records the data version
component attached to a dataset. Not meant to be configured."""@en ;
    rdfs:isDefinedBy <https://larsw.xyz/jip/> .
